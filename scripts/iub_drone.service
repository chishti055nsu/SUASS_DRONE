[Unit]
Description=IUB Drone Autonomous Flight Stack Auto-Start Service
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jetson
WorkingDirectory=/home/jetson/IUB_DRONE
ExecStart=/bin/bash /home/jetson/IUB_DRONE/scripts/run_drone_flight.sh
Restart=on-failure
RestartSec=5s
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
